# ── Python / Backend ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.env
.venv/
venv/
*.pyc

# Database (auto-created and seeded on startup — do not commit)
data/land_records.db

# Runtime upload and annotated directories (ephemeral)
backend/uploads/
backend/annotated/

# ── Node / Frontend ──────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env.local

# ── OS & Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

